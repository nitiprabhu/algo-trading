# Copy to .env for local development. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
INDMONEY_TOKEN=
CHARTEDGE_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Upstox live trading (positional stocks). Only needed if live_trading.enabled: true ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Shared secret the token webhook requires (set same value on the Upstox app webhook):
UPSTOX_WEBHOOK_SECRET=
# Where the daily access token is stored/read (default data/upstox_token.json):
UPSTOX_TOKEN_FILE=data/upstox_token.json
