"""
Real-data multi-symbol Iron Condor comparison, last 1 year (Jul 2025 - Jul 2026).
Data: NSE F&O bhavcopy (real settlement prices, real per-row lot size via NewBrdLotQty).
Symbols: NIFTY, BANKNIFTY (weekly) + RELIANCE, HDFCBANK, ICICIBANK, TCS, INFY, SBIN,
         LT, AXISBANK, KOTAKBANK, ITC (monthly - stock options have no weeklies in India).
Same exit rules for all: 55% profit-take, 2.2x credit stop, else hold to expiry.
"""
import csv, glob, json, math, zipfile, io
from collections import defaultdict
from datetime import datetime

PROJECT = "/Users/nithish-prabhu/Downloads/intra-day"
STEP_INDEX = 50
PROFIT_TAKE_FRAC = 0.55
STOP_MULT = 2.2
START_DATE = "20240701"

SYMBOLS_WEEKLY = {"NIFTY"}
SYMBOLS_MONTHLY = {"BANKNIFTY", "FINNIFTY", "NIFTYNXT50", "MIDCPNIFTY"}
ALL_SYMBOLS = SYMBOLS_WEEKLY | SYMBOLS_MONTHLY

vix_by_date = {}
with open(f"{PROJECT}/data/india_vix_1y.json") as f:
    for row in json.load(f):
        vix_by_date[row["date"]] = row["close"]

chain = defaultdict(lambda: defaultdict(lambda: defaultdict(dict)))
underlying_close = defaultdict(dict)
lot_size = {}  # symbol -> lot size (real, from NewBrdLotQty)

zips = sorted(glob.glob(f"{PROJECT}/data/nse_bhavcopy/*.zip"))
zips = [z for z in zips if z.split("_")[-1].replace(".csv.zip", "") >= START_DATE]

for zpath in zips:
    with zipfile.ZipFile(zpath) as zf:
        name = zf.namelist()[0]
        with zf.open(name) as fh:
            reader = csv.DictReader(io.TextIOWrapper(fh, encoding="utf-8"))
            for row in reader:
                sym = row["TckrSymb"]
                if sym not in ALL_SYMBOLS:
                    continue
                optn = row["OptnTp"]
                if optn not in ("CE", "PE"):
                    continue
                date = row["TradDt"]
                expiry = row["XpryDt"]
                strike = float(row["StrkPric"])
                close = float(row["ClsPric"])
                chain[date][sym][expiry].setdefault(strike, {})[optn] = close
                underlying_close[date][sym] = float(row["UndrlygPric"])
                if sym not in lot_size:
                    lot_size[sym] = int(row["NewBrdLotQty"])

dates = sorted(chain.keys())


def pick_strike(strikes, target):
    return min(strikes, key=lambda s: abs(s - target))


def get_expiries(sym, kind):
    all_exp = sorted({e for d in dates for e in chain[d].get(sym, {}).keys()})
    if kind == "weekly":
        return all_exp
    by_month = defaultdict(list)
    for e in all_exp:
        by_month[e[:7]].append(e)
    return sorted(v[-1] for v in by_month.values())


def strike_step(sym, spot):
    # rough step sizing by price level (matches NSE's typical strike intervals)
    if sym in ("NIFTY", "BANKNIFTY"):
        return STEP_INDEX
    if spot >= 5000:
        return 100
    if spot >= 2000:
        return 50
    if spot >= 500:
        return 20
    return 10


def run_condor(sym, kind):
    expiries = get_expiries(sym, kind)
    lot = lot_size.get(sym, 1)
    step = None
    trades = []
    for expiry in expiries:
        prior = [e for e in expiries if e < expiry]
        candidates = ([d for d in dates if d > prior[-1] and expiry in chain[d].get(sym, {})]
                      if prior else [d for d in dates if d <= expiry and expiry in chain[d].get(sym, {})])
        if not candidates:
            continue
        entry_date = candidates[0]
        entry_chain = chain[entry_date][sym][expiry]
        spot = underlying_close[entry_date][sym]
        step = strike_step(sym, spot)
        vix = vix_by_date.get(entry_date, 15.0) or 15.0
        dte = max((datetime.strptime(expiry, "%Y-%m-%d") - datetime.strptime(entry_date, "%Y-%m-%d")).days, 1)
        sigma = spot * (vix / 100.0) * math.sqrt(dte / 365.0)
        short_off = max(round(sigma * 0.85 / step) * step, 2 * step)
        wing_off = max(round(sigma * 1.30 / step) * step, short_off + 2 * step)
        atm = round(spot / step) * step
        avail = list(entry_chain.keys())
        if not avail:
            continue
        short_pe, long_pe = pick_strike(avail, atm - short_off), pick_strike(avail, atm - wing_off)
        short_ce, long_ce = pick_strike(avail, atm + short_off), pick_strike(avail, atm + wing_off)
        try:
            credit = (entry_chain[short_pe]["PE"] + entry_chain[short_ce]["CE"]) - \
                     (entry_chain[long_pe]["PE"] + entry_chain[long_ce]["CE"])
        except KeyError:
            continue
        if credit <= 0:
            continue
        cycle_dates = [d for d in dates if entry_date < d <= expiry and expiry in chain[d].get(sym, {})]
        exit_debit, exit_date = None, None
        for d in cycle_dates:
            dc = chain[d][sym][expiry]
            try:
                cur = (dc[short_pe]["PE"] + dc[short_ce]["CE"]) - (dc[long_pe]["PE"] + dc[long_ce]["CE"])
            except KeyError:
                continue
            if cur <= credit * (1 - PROFIT_TAKE_FRAC) or cur >= credit * STOP_MULT:
                exit_debit, exit_date = cur, d
                break
        if exit_debit is None:
            exit_candidates = [d for d in dates if d <= expiry and expiry in chain[d].get(sym, {})]
            if not exit_candidates:
                continue
            exit_date = exit_candidates[-1]
            try:
                exit_debit = (chain[exit_date][sym][expiry][short_pe]["PE"] + chain[exit_date][sym][expiry][short_ce]["CE"]) - \
                             (chain[exit_date][sym][expiry][long_pe]["PE"] + chain[exit_date][sym][expiry][long_ce]["CE"])
            except KeyError:
                continue
        pnl = round((credit - exit_debit) * lot, 2)
        trades.append({"expiry": expiry, "entry_date": entry_date, "pnl": pnl})
    return trades, lot


print(f"\n{'='*90}\nMULTI-SYMBOL IRON CONDOR — REAL DATA, last 1 year (Jul 2025 - Jul 2026)\n{'='*90}")
print(f"{'Symbol':12s} {'Cycle':8s} {'Lot':>6s} {'Cycles':>7s} {'Wins':>6s} {'Win%':>6s} {'Net PnL':>14s}")

results = []
for sym in sorted(SYMBOLS_WEEKLY):
    trades, lot = run_condor(sym, "weekly")
    results.append((sym, "weekly", lot, trades))
for sym in sorted(SYMBOLS_MONTHLY):
    trades, lot = run_condor(sym, "monthly")
    results.append((sym, "monthly", lot, trades))

report_rows = []
for sym, kind, lot, trades in results:
    n = len(trades)
    wins = sum(1 for t in trades if t["pnl"] > 0)
    win_pct = wins / n * 100 if n else 0
    total = sum(t["pnl"] for t in trades)
    print(f"{sym:12s} {kind:8s} {lot:6d} {n:7d} {wins:6d} {win_pct:5.0f}% {total:14,.2f}")
    report_rows.append((sym, kind, lot, n, wins, win_pct, total))

print(f"{'='*90}\n")

report_path = f"{PROJECT}/reports/real_data_multi_symbol_condor_2025-07_to_2026-07.md"
with open(report_path, "w") as f:
    f.write("# Real-Data Multi-Symbol Iron Condor Comparison — Last 1 Year (Jul 2025 to Jul 2026)\n\n")
    f.write("**Data:** NSE F&O bhavcopy real settlement prices, real per-symbol lot size (NewBrdLotQty). ")
    f.write("Index (NIFTY/BANKNIFTY): weekly cycles. Stocks: monthly cycles (no weeklies exist for stock options in India). ")
    f.write(f"**Exit rules:** {int(PROFIT_TAKE_FRAC*100)}% profit-take, {STOP_MULT}x credit stop, else hold to expiry.\n\n")
    f.write("## Summary (ranked by Net PnL)\n\n| Symbol | Cycle | Lot | Cycles | Wins | Win% | Net PnL |\n|---|---|---|---|---|---|---|\n")
    for sym, kind, lot, n, wins, win_pct, total in sorted(report_rows, key=lambda r: -r[6]):
        f.write(f"| {sym} | {kind} | {lot} | {n} | {wins} | {win_pct:.0f}% | Rs {total:,.2f} |\n")
    for sym, kind, lot, trades in results:
        f.write(f"\n## {sym} ({kind}) — Cycle Detail\n\n| Expiry | Entry | PnL |\n|---|---|---|\n")
        for t in trades:
            f.write(f"| {t['expiry']} | {t['entry_date']} | {t['pnl']:.2f} |\n")

print(f"Report saved to: {report_path}")
